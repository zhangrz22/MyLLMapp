<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="64dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/textViewMessageText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_message_user"
        android:textColor="@color/message_user_text"
        android:textAppearance="?attr/textAppearanceBody1"
        android:textIsSelectable="true"
        android:lineSpacingMultiplier="1.2"
        android:breakStrategy="high_quality"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:minWidth="40dp"
        android:maxWidth="300dp"
        android:gravity="start|center_vertical"
        android:autoSizeTextType="none"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_default="wrap"
        app:layout_constraintHorizontal_bias="1.0"
        tools:text="短消息" />

    <TextView
        android:id="@+id/textViewMessageTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:textColor="@color/text_secondary"
        app:layout_constraintTop_toBottomOf="@id/textViewMessageText"
        app:layout_constraintEnd_toEndOf="@id/textViewMessageText"
        tools:text="10:30" />

</androidx.constraintlayout.widget.ConstraintLayout>
